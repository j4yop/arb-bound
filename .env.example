# TinyFish API credentials — copy to .env and fill in.
#
# To use it:
#   cp .env.example .env
#   # then open .env and paste your key in place of the placeholder below
#
# The API key is displayed EXACTLY ONCE, when you create it at
# https://agent.tinyfish.ai/api-keys . If you lose it you must revoke it
# and create a new one. Never commit .env — it is gitignored (see .gitignore).
#
# Docs: https://docs.tinyfish.ai/authentication
# Quick start: https://docs.tinyfish.ai/quick-start

TINYFISH_API_KEY=sk-tinyfish-PASTE-YOUR-KEY-HERE

# Optional — the Python SDK reads TINYFISH_API_KEY from the environment by
# default, so you usually do not need to set anything else.
